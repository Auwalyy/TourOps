NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://your_db_user:your_db_password@your-cluster.mongodb.net/?appName=Cluster0
JWT_ACCESS_SECRET=your_access_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=offDoc
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="TourOps <noreply@tourops.com>"
OPENAI_API_KEY=your_openai_key

# Billing — Flutterwave (dashboard.flutterwave.com → Settings → API Keys)
# Use the TEST keys until you are ready to charge real money.
FLW_SECRET_KEY=FLWSECK_TEST-your_secret_key
FLW_PUBLIC_KEY=FLWPUBK_TEST-your_public_key
# Any random string. Set the SAME value in the Flutterwave dashboard under
# Settings → Webhooks → Secret hash, or webhooks will be rejected.
FLW_SECRET_HASH=change_me_to_a_long_random_string
FLW_REDIRECT_URL=http://localhost:3000/billing/callback

# Trial length and the read-only window after it lapses, in days.
TRIAL_DAYS=30
GRACE_DAYS=7
